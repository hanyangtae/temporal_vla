# Project Configuration
PROJECT_NAME=vla_dev
USER_NAME=bluebottle
USER_ID=1000
GROUP_ID=1000
HF_TOKEN=xxx

# ================================================================
# 사용 환경에 맞는 override 파일을 복사하세요:
#
#  [SSH 원격 접속 사용자 → VNC]
#    cp docker-compose.override.example.yml docker-compose.override.yml
#    → VNC_PW 설정 필요, DISPLAY 설정 불필요
#
#  [로컬 우분투 PC 직접 사용자]
#    cp docker-compose.override.local.example.yml docker-compose.override.yml
#    → DISPLAY 설정 필요, VNC_PW 설정 불필요
#    → 호스트에서 xhost +local:docker 실행 필요
# ================================================================

# [SSH 원격 접속 사용자] KasmVNC 접속 비밀번호
# https://<서버IP>:8444 로 접속
VNC_PW=your_vnc_password

# [로컬 우분투 PC 사용자] 호스트 디스플레이 번호
# 확인 방법: echo $DISPLAY
# DISPLAY=:0
