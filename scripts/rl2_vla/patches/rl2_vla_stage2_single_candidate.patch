+def _stage2_context(action_embeds: np.ndarray) -> list:
+    """First candidate, denoise-0 action-token mean; shape is exactly (1024,)."""
+    embeds = np.asarray(action_embeds)
+    if embeds.ndim != 4 or embeds.shape[0] < 1 or embeds.shape[1] < 1 or embeds.shape[2] < 2:
+        raise ValueError(f"Unexpected PI0 action_embeds shape: {embeds.shape}")
+    context = embeds[0, 0, 1:, :].mean(axis=0)
+    if context.shape != (1024,):
+        raise ValueError(f"Expected stage2 context shape (1024,), got {context.shape}")
+    return context.astype(np.float32).tolist()
+
+
+def _stage2_safe_feature(action_embeds, failure_model):
+    """Apply the original SAFE horizon-then-denoise transform, independently of QAM."""
+    values = np.asarray(action_embeds, dtype=np.float32)
+    if values.ndim != 4 or values.shape[0] != 1 or values.shape[2:] != (5, 1024):
+        raise ValueError(f"Expected single-candidate PI0 embeds (1,T,5,1024), got {values.shape}")
+    values = values[:, :, 1:, :]
+    for selector in (getattr(failure_model, "safe_horizon_idx_rel", "mean"),
+                     getattr(failure_model, "safe_diff_idx_rel", 0.0)):
+        if selector == "mean":
+            values = values.mean(axis=-2)
+        elif selector == "concat-2":
+            values = values[..., [0, values.shape[-2] - 1], :]
+            values = values.reshape(*values.shape[:-2], -1)
+        elif isinstance(selector, (int, float)) and 0 <= selector <= 1:
+            values = values[..., round((values.shape[-2] - 1) * selector), :]
+        else:
+            raise ValueError(f"Unsupported SAFE feature selector: {selector!r}")
+    feature = values[0].reshape(-1)
+    expected = getattr(failure_model, "safe_input_dim", 1024)
+    if feature.shape != (expected,) or not np.isfinite(feature).all():
+        raise ValueError(f"SAFE feature mismatch: got {feature.shape}, expected ({expected},)")
+    return feature
+
+
+def _atomic_write_stage2_episode(path: Path, payload: dict) -> None:
+    if path.exists():
+        raise FileExistsError(f"Refusing to overwrite existing stage2 rollout: {path}")
+    path.parent.mkdir(parents=True, exist_ok=True)
+    tmp_path = path.with_name(f".{path.name}.tmp-{os.getpid()}")
+    try:
+        with tmp_path.open("x", encoding="utf-8") as handle:
+            json.dump(payload, handle, ensure_ascii=False, indent=2)
+            handle.write("\n")
+            handle.flush()
+            os.fsync(handle.fileno())
+        try:
+            os.link(tmp_path, path)
+        except FileExistsError:
+            raise FileExistsError(f"Refusing to overwrite existing stage2 rollout: {path}")
+        finally:
+            tmp_path.unlink(missing_ok=True)
+    finally:
+        if tmp_path.exists():
+            tmp_path.unlink()
+
+
+def _stage2_save_activation_file(path: Path, features: list) -> dict:
+    import hashlib
+    path.parent.mkdir(parents=True, exist_ok=True)
+    tmp = path.with_name(f".{path.name}.tmp-{os.getpid()}")
+    try:
+        values = np.stack(features)
+        if values.ndim != 5 or not np.isfinite(values).all():
+            raise ValueError("Activation archive must be finite [chunks,N,denoise,tokens,features]")
+        with tmp.open("xb") as handle:
+            np.savez_compressed(handle, action_embeds=values)
+            handle.flush()
+            os.fsync(handle.fileno())
+        digest = hashlib.sha256(tmp.read_bytes()).hexdigest()
+        size = tmp.stat().st_size
+        os.link(tmp, path)
+        return {"path": path.name, "sha256": digest, "size_bytes": size,
+                "shape": list(values.shape), "dtype": str(values.dtype),
+                "includes_redundant_first_token": True}
+    finally:
+        tmp.unlink(missing_ok=True)
+
+
+def _stage2_wait_for_space(path: Path, minimum_gb: float) -> None:
+    import shutil
+    path.mkdir(parents=True, exist_ok=True)
+    while shutil.disk_usage(path).free < minimum_gb * 1024**3:
+        print(f"Waiting for archive transfer: less than {minimum_gb} GiB free", flush=True)
+        time.sleep(15)
+
+
+def _stage2_should_compose(use_failure_prediction: bool, safe_trigger: bool, composed_samples: int) -> bool:
+    return bool(use_failure_prediction and safe_trigger and composed_samples > 0)
+
+
+def _stage2_next_action(env_queue: deque):
+    if not env_queue:
+        raise IndexError("stage2 action queue is empty")
+    return env_queue.popleft()
+
+
+def _stage2_end_reason(done: bool, trunc: bool, step: int, max_steps: int) -> str:
+    return "success" if done else "truncated" if trunc else "horizon" if step >= max_steps else "terminated"
