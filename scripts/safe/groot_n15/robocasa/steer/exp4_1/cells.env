# exp4-1 cell 파라미터 (e30 ho_base 사이드카에서 프로그램 생성 — 수기 금지)
# CELL_ID 별 TASK/ENVN/CELL_INDEX/INSTR — run_oracle_rescue.sh 가 source
cell_params() {
  case "$1" in
    pq3_ppcc_bread) TASK="PickPlaceCounterToCabinet"; ENVN="robocasa_panda_omron/PickPlaceCounterToCabinet_PandaOmron_Env"; CELL_INDEX=5; INSTR="Pick the bread from the counter and place it in the cabinet." ;;
    pq3_ppcc_beer) TASK="PickPlaceCounterToCabinet"; ENVN="robocasa_panda_omron/PickPlaceCounterToCabinet_PandaOmron_Env"; CELL_INDEX=15; INSTR="Pick the beer from the counter and place it in the cabinet." ;;
    pq3_drawer_left) TASK="OpenDrawer"; ENVN="robocasa_panda_omron/OpenDrawer_PandaOmron_Env"; CELL_INDEX=8; INSTR="Open the left drawer." ;;
    pq3_drawer_right) TASK="OpenDrawer"; ENVN="robocasa_panda_omron/OpenDrawer_PandaOmron_Env"; CELL_INDEX=7; INSTR="Open the right drawer." ;;
    exp41_mixer) TASK="OpenStandMixerHead"; ENVN="robocasa_panda_omron/OpenStandMixerHead_PandaOmron_Env"; CELL_INDEX=0; INSTR="Open the stand mixer head." ;;
    *) echo "unknown cell: $1" >&2; return 1 ;;
  esac
}
